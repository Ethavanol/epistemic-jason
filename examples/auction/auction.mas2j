// simple implementation of first-price sealed-bid auction

MAS auction {

    agents: ag1 agentClass example.TestAgent;
            ag2 agentClass example.TestAgent;
            ag3 [mindinspector="gui(cycle,html,history)"] agentClass example.TestAgent; // this agent has a GUI mind inspector
            auctioneer agentArchClass AuctioneerGUI;
}
